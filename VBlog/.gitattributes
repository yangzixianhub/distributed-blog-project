# Normalize text files across Windows/macOS/Linux.
* text=auto

# Source and configuration files should use LF in the repository.
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.html text eol=lf

# Windows scripts should keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary

# Built frontend assets copied into blogserver are generated artifacts.
blogserver/src/main/resources/static/** linguist-generated=true
