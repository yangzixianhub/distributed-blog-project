{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkerId": "",
  "UseMachineId": true,
  "UseCircuitBreaker": true,
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "OpenStateDurationSeconds": 30,
    "HalfOpenMaxCalls": 3
  }
}
