{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeys": [
    {
      "Key": "blog-article-service-key",
      "Name": "文章服务",
      "Enabled": true
    },
    {
      "Key": "blog-comment-service-key",
      "Name": "评论服务",
      "Enabled": true
    },
    {
      "Key": "blog-like-service-key",
      "Name": "点赞服务",
      "Enabled": true
    }
  ],
  "WorkerId": "",
  "UseMachineId": true,
  "UseCircuitBreaker": true,
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "OpenStateDurationSeconds": 30,
    "HalfOpenMaxCalls": 3
  }
}
